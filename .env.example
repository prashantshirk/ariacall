# Google Gemini API Key for Gemini Multimodal Live API (Aoede/Kore Voice)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Frontend Backend Base URL (leave empty when served from the same origin on Render)
VITE_API_BASE=

# Set to 0 to use live backend with Gemini Live audio relay
# Set to 1 to use offline browser mock engine
VITE_MOCK=0
